# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# The keys and secrets are Vercel Secret variables, which cannot sit in the
# Development scope that `vercel env pull` reads, so each machine fills them in
# by hand.

# --- Airtable (#534) ---------------------------------------------------------
# Local development and every script reach the TEST base, a copy of the live one.
AIRTABLE_TEST_API_KEY=
AIRTABLE_TEST_BASE_ID=

# The LIVE base's key. Leave it out unless this machine has to run a command
# against the live base; without it, nothing here can reach that base. Even with
# it, a command reaches the live base only by naming it, for that command alone:
#   AIRTABLE_BASE=live node --env-file=.env.local scripts/...
# Never put AIRTABLE_BASE in this file. The live base's id is in
# lib/airtableBase.js and nowhere else, and AIRTABLE_BASE_ID is read by nothing.
# AIRTABLE_API_KEY=

# Optional: count Airtable operations (lib/airtableOps.js). `summary` or `verbose`,
# and `1` (or a path) to append them to .airtable-ops.jsonl.
# AIRTABLE_OPS_LOG=summary
# AIRTABLE_OPS_FILE=1

# --- Sign-in and mail --------------------------------------------------------
SESSION_SECRET=
RESEND_API_KEY=
ALLOWED_EMAIL_DOMAIN=
# EMAIL_FROM=

# --- Vercel Blob -------------------------------------------------------------
# The store an upload lands in before Airtable takes its own copy: the one Vercel
# connects to Development, never a store connected to Production alone.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
